# Only the app and its build setup go to GitHub; everything else in this folder
# (IPA extracts, old zips, test pages) stays local.
/*
!/Murekkep.swiftpm/
!/.github/
!/.gitignore
!/README.md

# Xcode and macOS leftovers inside the package.
.DS_Store
xcuserdata/
*.xcuserstate
.build/
.swiftpm/xcode/
DerivedData/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json
!/ml/
!/docs/
!/tests/
!/tools/
/ml/**/data/
/ml/**/runs/
/ml/**/*.pt
/ml/**/*.onnx

# Local secrets (Higgsfield API key and the like) never go to GitHub.
.env.local
.env*.local
